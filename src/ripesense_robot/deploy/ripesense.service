[Unit]
Description=RipeSense scan controller + kiosk web app
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__REPO__
EnvironmentFile=-__REPO__/.env
ExecStart=__REPO__/.venv/bin/python -m ripesense.app
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
